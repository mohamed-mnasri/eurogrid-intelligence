# EuroGrid reads these from the process environment. Nothing is required: every value has the default shown.
# PowerShell example:  $env:EUROGRID_DB_PATH="data/demo/eurogrid_demo.duckdb"
# Keep real values out of Git (.env is gitignored).

# DuckDB file the API, pipeline and tools read
EUROGRID_DB_PATH=data/eurogrid.duckdb
# Folder for raw files, cache, metadata stores (data/metadata) and chaos copies
EUROGRID_DATA_DIR=data
# dbt project folder whose target/ artifacts Data Operations shows
EUROGRID_DBT_DIR=eurogrid_analytics
# dbt executable with the DuckDB adapter (default: .venv-dbt, then dbt on PATH if it has the adapter)
EUROGRID_DBT_EXECUTABLE=
# Python logging level for the API, pipeline and agent: DEBUG, INFO, WARNING, ERROR
EUROGRID_LOG_LEVEL=INFO

# Not used yet: ENTSO-E (outages) is not connected. If it is added, keep the token here, never in code.
ENTSOE_API_TOKEN=
